-- AUTOMATION & MECHANICS LOGIC
-- ====================================================================

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
end)

-- Safe Remote Helper Function
local function fireRemote(remotePath, ...)
    local args = {...}
    pcall(function()
        local current = ReplicatedStorage
        for _, name in ipairs(remotePath) do
            current = current:FindFirstChild(name)
        end
        if current then
            if current:IsA("RemoteEvent") then
                current:FireServer(unpack(args))
            elseif current:IsA("RemoteFunction") then
                current:InvokeServer(unpack(args))
            end
        end
    end)
end

-- 1. AUTO PULL / STREAM (Triggers Stream Remotes & Taps)
local function processAutoPull()
    if not Config.AutoPull then return end
    fireRemote({"Events", "PullCheese"})
    fireRemote({"Events", "StreamClick"})
    fireRemote({"Remotes", "Pull"})
    fireRemote({"Network", "TapStream"})
end

-- 2. AUTO BUY CRATES
local function processAutoBuyCrates()
    if not Config.AutoBuyCrates then return end
    fireRemote({"Events", "BuyCrate"}, Config.SelectedCrate)
    fireRemote({"Remotes", "PurchaseCrate"}, Config.SelectedCrate)
end

-- 3. AUTO PLACE CRATES
local function processAutoPlaceCrates()
    if not Config.AutoPlaceCrates then return end
    fireRemote({"Events", "PlaceAllCrates"})
    fireRemote({"Remotes", "UnpackCrate"})
end

-- 4. AUTO UPGRADE STUDIO
local function processAutoUpgrade()
    if not Config.AutoUpgrade then return end
    fireRemote({"Events", "UpgradeStudio"})
    fireRemote({"Remotes", "BuyUpgrade"}, "All")
    
    -- Auto Touch Upgrade Buttons in Tycoon Base
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "UpgradeButton" or obj.Name == "BuyButton" then
            if obj:IsA("BasePart") and Character and Character:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    firetouchinterest(Character.HumanoidRootPart, obj, 0)
                    firetouchinterest(Character.HumanoidRootPart, obj, 1)
                end)
            end
        end
    end
end

-- 5. CLAIM REWARDS
local function processClaimRewards()
    if not Config.ClaimRewards then return end
    for i = 1, 12 do
        fireRemote({"Events", "ClaimGift"}, i)
        fireRemote({"Remotes", "ClaimPlaytime"}, i)
    end
    fireRemote({"Events", "ClaimDaily"})
end

-- 6. SPEED ADJUSTER
RunService.Heartbeat:Connect(function()
    if Config.SpeedHack and Humanoid and Humanoid.Parent then
        if Humanoid.MoveDirection.Magnitude > 0 then
            Character:TranslateBy(Humanoid.MoveDirection * (Config.CustomSpeed / 50))
        end
    end
end)

-- 7. PASS-THROUGH (NOCLIP)
RunService.Stepped:Connect(function()
    if Config.PassThrough and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Main Execution Thread Loop
task.spawn(function()
    print("[Stream A Cheese Pull!] Script Loaded.")
    while task.wait(0.15) do
        if Config.AutoPull then
            processAutoPull()
        end
        if Config.AutoBuyCrates then
            processAutoBuyCrates()
        end
        if Config.AutoPlaceCrates then
            processAutoPlaceCrates()
        end
        if Config.AutoUpgrade then
            processAutoUpgrade()
        end
        if Config.ClaimRewards then
            processClaimRewards()
        end
    end
end)
